# Metin dosyalarini normalize et, ikili dosyalara dokunma
* text=auto

# Konteyner icinde calisan dosyalar MUTLAKA LF olmali.
# CRLF ile kaydedilen bir run.sh Docker icinde "no such file" hatasi verir.
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
