# Ornek yapilandirma. GERCEK DEGERLERI BU DOSYAYA YAZMAYIN.
# Bu depo public'tir; sirlar yalnizca Home Assistant eklenti ayarlarinda veya
# versiyonlanmayan yerel bir .env dosyasinda yasar.

# BotFather'dan alinan token
TELEGRAM_BOT_TOKEN=123456789:BURAYA_GERCEK_TOKEN_GELMEZ

# Yetkili Telegram kullanici kimlikleri (virgulle ayrilmis)
AUTHORIZED_TELEGRAM_IDS=111111111,222222222

# Kimlik -> gorunen ad
USER_DISPLAY_NAMES=111111111:Aykut,222222222:Aslihan

# Home Assistant kullanici kimligi -> Telegram kimligi
HA_USER_MAP=00000000000000000000000000000000:111111111

# Telegram Mini App'in acilacagi genel adres (bos birakilabilir)
WEBAPP_PUBLIC_URL=

DATABASE_PATH=./data/budget.db
TIMEZONE=Europe/Istanbul
LOG_LEVEL=info
BACKUP_RETENTION=14

# Yalnizca yerel gelistirmede: tarayicidan denemek icin kimlik basligi
ALLOW_DEV_AUTH=false
DEBUG=false
