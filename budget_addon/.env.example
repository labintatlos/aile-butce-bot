# Ornek yapilandirma. GERCEK DEGERLERI BU DOSYAYA YAZMAYIN.
# Bu depo public'tir; sirlar yalnizca Home Assistant eklenti ayarlarinda veya
# versiyonlanmayan yerel bir .env dosyasinda yasar.
#
# Hicbir ayar zorunlu degildir. Kisiler ve sifreler sitenin kendisinde
# yonetilir: ilk acilista gunlukte yazan kurulum koduyla yonetici olusturulur.

# Sitenin internetten acildigi adres. E-posta ve anlik bildirim baglantilari
# bu adrese gore kurulur (bos birakilabilir).
SITE_URL=

# Home Assistant paneli icin: HA kullanici kimligi -> sitedeki kullanici adi
HA_USER_MAP=00000000000000000000000000000000:aykut

# Oturum cerezini imzalayan anahtar. Bos birakilirsa veritabaninin yanindaki
# session_secret dosyasinda kendiliginden uretilir.
SESSION_SECRET=

# E-posta bildirimleri (bos birakilirsa e-posta secenegi gizlenir)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

DATABASE_PATH=./data/budget.db
TIMEZONE=Europe/Istanbul
LOG_LEVEL=info
BACKUP_RETENTION=14
DEBUG=false
